/**
 * Progetto 16: K-Pop Network Analysis
 * Corso di Visualizzazione delle Informazioni
 * Codice sorgente strutturato ad Oggetti (OOP) e ottimizzato
 */

const CONFIG = {
    paths: {
        nodes: "../data/K-pop_node.csv",
        edges: "../data/K-pop_edge.csv"
    },
    nodeColors: {
        "label": "#ef4444",
        "group": "#3b82f6",
        "person": "#10b981",
        "male": "#06b6d4",
        "female": "#ec4899"
    },
    typeBadges: {
        label: { text: "Agenzia", css: "bg-red-500/20 text-red-400 border border-red-500/30" },
        group: { text: "Gruppo", css: "bg-blue-500/20 text-blue-400 border border-blue-500/30" },
        person: { text: "Idol", css: "bg-emerald-500/20 text-emerald-400 border border-emerald-500/30" },
        male: { text: "Idol (M)", css: "bg-cyan-500/20 text-cyan-400 border border-cyan-500/30" },
        female: { text: "Idol (F)", css: "bg-pink-500/20 text-pink-400 border border-pink-500/30" }
    },
    edgeColors: {
        management: "#ef4444",
        membership: "#3b82f6",
        association: "#10b981"
    },
    nodeRadii: {
        label: 10,
        group: 7.5,
        default: 5.5
    },
    forces: {
        chargeStrength: -80,
        linkDistance: 75,
        collisionRadius: 18,
        alphaTargetDrag: 0.15,
        alphaUpdateRestart: 0.15
    }
};

class KPopNetworkGraph {
    constructor() {
        this.globalNodes = [];
        this.globalEdges = [];

        this.selectedNode = null;
        this.searchQuery = "";
        this.adjacency = new Map();
        this._prevNodeCount = 0;

        // Canvas
        this.canvas = null;
        this.ctx = null;
        this.canvasW = 0;
        this.canvasH = 0;
        this.transform = { x: 0, y: 0, k: 1 };
        this.hoveredNode = null;
        this.dragState = { active: false, node: null, startX: 0, startY: 0, panStartX: 0, panStartY: 0, clickPos: null };

        // Visual state
        this.connectedNodeIds = new Set();
        this.searchMatchedIds = new Set();

        this.simulation = null;

        this.dom = {
            container: document.getElementById("canvas-container"),
            loading: document.getElementById("loading"),

            filterLabel: document.getElementById("filter-label"),
            filterGroup: document.getElementById("filter-group"),
            filterPerson: document.getElementById("filter-person"),

            searchInput: document.getElementById("search-input"),
            searchClear: document.getElementById("search-clear"),
            searchResultsCount: document.getElementById("search-results-count"),

            detailsBox: document.getElementById("details-box"),
            detailsClose: document.getElementById("details-close"),
            detailName: document.getElementById("detail-name"),
            detailTypeBadge: document.getElementById("detail-type-badge"),
            detailConnections: document.getElementById("detail-connections"),
            detailConnectionsSection: document.getElementById("detail-connections-list-section"),
            detailConnectionsList: document.getElementById("detail-connections-list"),

            btnResetZoom: document.getElementById("btn-reset-zoom")
        };
    }

    async initialize() {
        try {
            const [nodesData, edgesData] = await Promise.all([
                d3.csv(CONFIG.paths.nodes),
                d3.csv(CONFIG.paths.edges)
            ]);

            if (this.dom.loading) {
                this.dom.loading.classList.add("hidden");
            }

            this.globalNodes = nodesData.map(d => ({
                id: d.id.trim(),
                name: d.name.trim(),
                type: d.type.trim()
            }));

            const nodeTypeMap = new Map(this.globalNodes.map(n => [n.id, n.type]));

            this.globalEdges = edgesData.map(e => {
                const srcId = e.source.trim();
                const tgtId = e.target.trim();
                const srcType = nodeTypeMap.get(srcId);
                const tgtType = nodeTypeMap.get(tgtId);
                let relType = "association";
                if (srcType === "label") {
                    relType = "management";
                } else if ((srcType === "person" || srcType === "male" || srcType === "female") && tgtType === "group") {
                    relType = "membership";
                }
                return {
                    source: srcId,
                    target: tgtId,
                    relation: relType
                };
            });

            this.globalNodes.forEach(n => this.adjacency.set(n.id, new Set()));
            this.globalEdges.forEach(e => {
                const s = e.source.id || e.source;
                const t = e.target.id || e.target;
                this.adjacency.get(s)?.add(t);
                this.adjacency.get(t)?.add(s);
            });

            this.initCanvas();
            this.setupListeners();
            this.updateGraph();

        } catch (error) {
            console.error("Errore critico durante l'inizializzazione dell'applicazione:", error);
            if (this.dom.loading) {
                this.dom.loading.innerHTML = `
                    <div class='bg-red-500/10 border border-red-500/30 rounded-lg p-5 text-center max-w-md mx-auto shadow-xl'>
                        <p class='text-red-400 font-semibold mb-2'>Errore nel caricamento dei dati CSV</p>
                        <p class='text-xs text-slate-400 mb-4'>Verifica che la cartella 'data' sia accessibile e che il server locale sia avviato nella cartella principale.</p>
                        <span class='text-[10px] font-mono bg-slate-950 p-2 block rounded text-red-500/80 break-words'>${error.message}</span>
                    </div>`;
            }
        }
    }

    initCanvas() {
        const container = this.dom.container;
        const width = container.clientWidth;
        const height = container.clientHeight;

        this.canvas = document.createElement("canvas");
        this.canvas.style.display = "block";
        container.prepend(this.canvas);

        const dpr = window.devicePixelRatio || 1;
        this.canvasW = width;
        this.canvasH = height;
        this.canvas.width = width * dpr;
        this.canvas.height = height * dpr;
        this.canvas.style.width = width + "px";
        this.canvas.style.height = height + "px";

        this.ctx = this.canvas.getContext("2d");

        this.simulation = d3.forceSimulation()
            .force("link", d3.forceLink().id(d => d.id).distance(CONFIG.forces.linkDistance))
            .force("charge", d3.forceManyBody().strength(CONFIG.forces.chargeStrength))
            .force("center", d3.forceCenter(width / 2, height / 2))
            .force("collision", d3.forceCollide().radius(CONFIG.forces.collisionRadius));

        this.simulation.on("tick", () => this.draw());

        this.canvas.addEventListener("mousedown", (e) => this.onMouseDown(e));
        this.canvas.addEventListener("mousemove", (e) => this.onMouseMove(e));
        this.canvas.addEventListener("mouseup", (e) => this.onMouseUp(e));
        this.canvas.addEventListener("click", (e) => this.onClick(e));
        this.canvas.addEventListener("wheel", (e) => this.onWheel(e), { passive: false });
        this.canvas.addEventListener("mouseleave", () => this.onMouseLeave());

        const oldSvg = container.querySelector("svg");
        if (oldSvg) oldSvg.remove();
    }

    draw() {
        const ctx = this.ctx;
        if (!ctx) return;

        const dpr = window.devicePixelRatio || 1;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        ctx.fillStyle = "#0f172a";
        ctx.fillRect(0, 0, this.canvasW, this.canvasH);

        const activeNodes = this.getActiveNodes();
        const activeEdges = this.getActiveEdges();
        if (!activeNodes.length) return;

        ctx.save();
        ctx.translate(this.transform.x, this.transform.y);
        ctx.scale(this.transform.k, this.transform.k);

        // Determine highlighted set
        const highlightedIds = new Set();
        let hasHighlight = false;

        if (this.searchQuery) {
            hasHighlight = true;
            this.searchMatchedIds.forEach(id => highlightedIds.add(id));
        } else if (this.selectedNode) {
            hasHighlight = true;
            this.connectedNodeIds.forEach(id => highlightedIds.add(id));
        } else if (this.hoveredNode) {
            hasHighlight = true;
            highlightedIds.add(this.hoveredNode.id);
            const adj = this.adjacency.get(this.hoveredNode.id);
            if (adj) adj.forEach(id => highlightedIds.add(id));
        }

        const nodeAlpha = (n) => {
            if (!hasHighlight) return 0.85;
            return highlightedIds.has(n.id) ? 1 : 0.08;
        };

        const edgeAlpha = (e) => {
            if (!hasHighlight) return 0.12;
            const srcId = e.source.id || e.source;
            const tgtId = e.target.id || e.target;
            return highlightedIds.has(srcId) || highlightedIds.has(tgtId) ? 0.6 : 0.02;
        };

        // Viewport culling (world coords)
        const vp = {
            x: -this.transform.x / this.transform.k - 60,
            y: -this.transform.y / this.transform.k - 60,
            w: this.canvasW / this.transform.k + 120,
            h: this.canvasH / this.transform.k + 120
        };

        // --- Edges ---
        ctx.lineWidth = 1;
        for (const e of activeEdges) {
            const src = e.source;
            const tgt = e.target;
            if (!src || !tgt) continue;

            ctx.globalAlpha = edgeAlpha(e);
            ctx.strokeStyle = CONFIG.edgeColors[e.relation] || CONFIG.edgeColors.association;
            ctx.beginPath();
            ctx.moveTo(src.x, src.y);
            ctx.lineTo(tgt.x, tgt.y);
            ctx.stroke();
        }

        // --- Nodes ---
        ctx.globalAlpha = 1;
        const showLabels = this.transform.k > 0.4;

        for (const n of activeNodes) {
            if (n.x < vp.x || n.x > vp.x + vp.w || n.y < vp.y || n.y > vp.y + vp.h) continue;

            const radius = CONFIG.nodeRadii[n.type] || CONFIG.nodeRadii.default;
            const fill = CONFIG.nodeColors[n.type] || "#ffffff";
            const a = nodeAlpha(n);

            ctx.beginPath();
            ctx.arc(n.x, n.y, radius, 0, Math.PI * 2);
            ctx.globalAlpha = a;
            ctx.fillStyle = fill;
            ctx.fill();

            ctx.globalAlpha = Math.min(a, 0.5);
            ctx.strokeStyle = "#0f172a";
            ctx.lineWidth = 1.5;
            ctx.stroke();

            // Highlight ring for hovered/selected node
            if ((n === this.hoveredNode && !this.selectedNode && !this.searchQuery) || n === this.selectedNode) {
                ctx.beginPath();
                ctx.arc(n.x, n.y, radius + 2.5, 0, Math.PI * 2);
                ctx.globalAlpha = 1;
                ctx.strokeStyle = "#ffffff";
                ctx.lineWidth = 2.5;
                ctx.stroke();
            }
        }

        // --- Labels ---
        if (showLabels) {
            ctx.globalAlpha = 1;
            ctx.font = "11px sans-serif";
            ctx.textBaseline = "middle";
            for (const n of activeNodes) {
                if (n.x < vp.x || n.x > vp.x + vp.w || n.y < vp.y || n.y > vp.y + vp.h) continue;
                const a = nodeAlpha(n);
                const radius = CONFIG.nodeRadii[n.type] || CONFIG.nodeRadii.default;
                ctx.globalAlpha = a * 0.85;
                ctx.fillStyle = "#94a3b8";
                ctx.fillText(n.name, n.x + radius + 4, n.y);
            }
        }

        ctx.restore();
    }

    updateGraph() {
        const showLabel = this.dom.filterLabel.checked;
        const showGroup = this.dom.filterGroup.checked;
        const showPerson = this.dom.filterPerson.checked;

        const isVisible = (type) => {
            if (type === "label") return showLabel;
            if (type === "group") return showGroup;
            if (type === "person" || type === "male" || type === "female") return showPerson;
            return true;
        };

        const filteredNodes = this.globalNodes.filter(n => isVisible(n.type));
        const activeNodeIds = new Set(filteredNodes.map(n => n.id));
        const isAddingNodes = filteredNodes.length > this._prevNodeCount;
        this._prevNodeCount = filteredNodes.length;

        const filteredEdges = this.globalEdges.filter(e => {
            const sourceId = e.source.id || e.source;
            const targetId = e.target.id || e.target;
            return activeNodeIds.has(sourceId) && activeNodeIds.has(targetId);
        });

        if (this.selectedNode && !activeNodeIds.has(this.selectedNode.id)) {
            this.clearNodeSelection();
        }

        this.simulation.nodes(filteredNodes);
        this.simulation.force("link").links(filteredEdges);

        if (isAddingNodes) {
            this.simulation.alpha(CONFIG.forces.alphaUpdateRestart).restart();
        } else {
            this.simulation.alpha(0.03).restart();
        }

        if (this.searchQuery) {
            this.applySearchHighlight();
        } else {
            this.draw();
        }
    }

    getActiveNodes() {
        return this.simulation ? this.simulation.nodes() : [];
    }

    getActiveEdges() {
        if (!this.simulation) return [];
        const f = this.simulation.force("link");
        return f ? f.links() : [];
    }

    screenToWorld(e) {
        const rect = this.canvas.getBoundingClientRect();
        return {
            x: (e.clientX - rect.left - this.transform.x) / this.transform.k,
            y: (e.clientY - rect.top - this.transform.y) / this.transform.k
        };
    }

    findNodeAt(wx, wy) {
        let closest = null;
        let minDist = Infinity;
        for (const n of this.getActiveNodes()) {
            const dx = n.x - wx;
            const dy = n.y - wy;
            const dist = dx * dx + dy * dy;
            const threshold = Math.max(CONFIG.nodeRadii[n.type] || CONFIG.nodeRadii.default, 5) + 3;
            if (dist < threshold * threshold && dist < minDist) {
                minDist = dist;
                closest = n;
            }
        }
        return closest;
    }

    onMouseDown(e) {
        this.dragState.clickPos = { x: e.clientX, y: e.clientY };
        const pos = this.screenToWorld(e);
        const node = this.findNodeAt(pos.x, pos.y);

        if (node) {
            this.dragState.active = true;
            this.dragState.node = node;
            node.fx = node.x;
            node.fy = node.y;
            this.simulation.alphaTarget(CONFIG.forces.alphaTargetDrag).restart();
        } else {
            this.dragState.active = true;
            this.dragState.node = null;
            this.dragState.panStartX = this.transform.x;
            this.dragState.panStartY = this.transform.y;
            this.dragState.startX = e.clientX;
            this.dragState.startY = e.clientY;
        }
    }

    onMouseMove(e) {
        const pos = this.screenToWorld(e);

        if (this.dragState.active) {
            if (this.dragState.node) {
                this.dragState.node.fx = pos.x;
                this.dragState.node.fy = pos.y;
            } else {
                this.transform.x = this.dragState.panStartX + (e.clientX - this.dragState.startX);
                this.transform.y = this.dragState.panStartY + (e.clientY - this.dragState.startY);
                this.draw();
            }
            return;
        }

        if (this.selectedNode || this.searchQuery) return;

        const node = this.findNodeAt(pos.x, pos.y);
        if (node !== this.hoveredNode) {
            this.hoveredNode = node;
            this.draw();
        }
    }

    onMouseUp() {
        if (!this.dragState.active) return;
        if (this.dragState.node) {
            this.dragState.node.fx = null;
            this.dragState.node.fy = null;
            this.simulation.alphaTarget(0);
        }
        this.dragState.active = false;
        this.dragState.node = null;
    }

    onClick(e) {
        const cp = this.dragState.clickPos;
        if (cp) {
            const dx = e.clientX - cp.x;
            const dy = e.clientY - cp.y;
            if (dx * dx + dy * dy > 25) return;
        }

        const pos = this.screenToWorld(e);
        const node = this.findNodeAt(pos.x, pos.y);

        if (node) {
            this.selectNode(node);
        } else if (this.selectedNode) {
            this.clearNodeSelection();
        }
    }

    onWheel(e) {
        e.preventDefault();
        const rect = this.canvas.getBoundingClientRect();
        const mx = e.clientX - rect.left;
        const my = e.clientY - rect.top;

        const delta = e.deltaY > 0 ? 0.92 : 1.08;
        const newK = this.transform.k * delta;
        if (newK < 0.05 || newK > 8) return;

        this.transform.x = mx - delta * (mx - this.transform.x);
        this.transform.y = my - delta * (my - this.transform.y);
        this.transform.k = newK;
        this.draw();
    }

    onMouseLeave() {
        if (this.hoveredNode && !this.selectedNode && !this.searchQuery) {
            this.hoveredNode = null;
            this.draw();
        }
    }

    selectNode(node) {
        this.selectedNode = node;
        this.hoveredNode = null;

        this.showNodeDetails(node);

        this.connectedNodeIds.clear();
        this.connectedNodeIds.add(node.id);
        const adj = this.adjacency.get(node.id);
        if (adj) adj.forEach(id => this.connectedNodeIds.add(id));

        this.draw();
        this.panToNode(node);
    }

    clearNodeSelection() {
        this.selectedNode = null;
        this.dom.detailsBox.classList.add("hidden");
        this.connectedNodeIds.clear();

        if (this.searchQuery) {
            this.applySearchHighlight();
        } else {
            this.draw();
        }
    }

    showNodeDetails(node) {
        const self = this;
        const box = this.dom.detailsBox;
        box.classList.remove("hidden");

        this.dom.detailName.innerText = node.name;

        const badgeDef = CONFIG.typeBadges[node.type] || { text: node.type, css: "bg-slate-700 text-slate-300" };
        this.dom.detailTypeBadge.innerText = badgeDef.text;
        this.dom.detailTypeBadge.className = `px-2 py-0.5 rounded text-xs font-bold uppercase tracking-wider ${badgeDef.css}`;

        const currentLinks = [];
        const activeEdges = this.getActiveEdges();
        for (const e of activeEdges) {
            const srcId = e.source.id || e.source;
            const tgtId = e.target.id || e.target;
            if (srcId === node.id || tgtId === node.id) {
                const neighbor = srcId === node.id ? e.target : e.source;
                currentLinks.push({ neighbor: neighbor, relation: e.relation });
            }
        }

        this.dom.detailConnections.innerText = `${currentLinks.length} relazioni attive visibili`;

        if (currentLinks.length > 0) {
            this.dom.detailConnectionsSection.classList.remove("hidden");
            this.dom.detailConnectionsList.innerHTML = "";

            currentLinks.forEach(link => {
                const neighbor = link.neighbor;
                const row = document.createElement("button");
                row.className = "w-full text-left flex justify-between items-center bg-slate-800/40 hover:bg-pink-500/10 hover:border-pink-500/20 border border-transparent p-1.5 rounded transition-all cursor-pointer text-slate-300 hover:text-pink-300 text-[11px] focus:outline-none";

                let relLabel = "Collaborazione";
                let relColorClass = "text-emerald-400";
                if (link.relation === "management") {
                    relLabel = "Management";
                    relColorClass = "text-red-400";
                } else if (link.relation === "membership") {
                    relLabel = "Membro";
                    relColorClass = "text-blue-400";
                }

                row.innerHTML = `
                    <span class="font-semibold truncate pr-2 max-w-[130px]">${neighbor.name}</span>
                    <span class="text-[9px] uppercase tracking-wider font-bold ${relColorClass}">${relLabel}</span>
                `;

                row.addEventListener("click", (e) => {
                    e.stopPropagation();
                    self.selectNode(neighbor);
                });

                this.dom.detailConnectionsList.appendChild(row);
            });
        } else {
            this.dom.detailConnectionsSection.classList.add("hidden");
        }
    }

    setupSearch() {
        const input = this.dom.searchInput;
        const clearBtn = this.dom.searchClear;
        const resultsCount = this.dom.searchResultsCount;

        const handleSearch = () => {
            this.searchQuery = input.value.toLowerCase().trim();

            if (this.searchQuery === "") {
                clearBtn.classList.add("hidden");
                resultsCount.classList.add("hidden");
                this.searchMatchedIds.clear();
                if (this.selectedNode) {
                    this.connectedNodeIds.clear();
                    this.connectedNodeIds.add(this.selectedNode.id);
                    const adj = this.adjacency.get(this.selectedNode.id);
                    if (adj) adj.forEach(id => this.connectedNodeIds.add(id));
                }
                this.draw();
            } else {
                clearBtn.classList.remove("hidden");
                this.applySearchHighlight();
            }
        };

        let searchTimeout;
        input.addEventListener("input", () => {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(handleSearch, 80);
        });

        clearBtn.addEventListener("click", () => {
            input.value = "";
            clearTimeout(searchTimeout);
            handleSearch();
        });
    }

    applySearchHighlight() {
        const query = this.searchQuery;
        if (!query) return;

        this.searchMatchedIds.clear();
        for (const n of this.getActiveNodes()) {
            if (n.name.toLowerCase().includes(query) || n.id.toLowerCase().includes(query)) {
                this.searchMatchedIds.add(n.id);
            }
        }

        const count = this.searchMatchedIds.size;
        const countDiv = this.dom.searchResultsCount;
        countDiv.classList.remove("hidden");
        if (count === 0) {
            countDiv.innerHTML = "<span class='text-red-400 font-semibold'>Nessun risultato trovato</span>";
        } else {
            countDiv.innerHTML = `<span class='text-pink-400 font-semibold'>${count}</span> ${count === 1 ? 'nodo trovato' : 'nodi trovati'}`;
        }

        this.draw();
    }

    resetZoom() {
        const startX = this.transform.x;
        const startY = this.transform.y;
        const startK = this.transform.k;
        const startTime = performance.now();
        const duration = 750;

        const animate = (time) => {
            const t = Math.min((time - startTime) / duration, 1);
            const ease = 1 - Math.pow(1 - t, 3);

            this.transform.x = startX + (0 - startX) * ease;
            this.transform.y = startY + (0 - startY) * ease;
            this.transform.k = startK + (1 - startK) * ease;
            this.draw();

            if (t < 1) requestAnimationFrame(animate);
        };

        requestAnimationFrame(animate);
    }

    panToNode(node) {
        const targetX = this.canvasW / 2 - node.x * this.transform.k;
        const targetY = this.canvasH / 2 - node.y * this.transform.k;

        const startX = this.transform.x;
        const startY = this.transform.y;
        const startTime = performance.now();
        const duration = 750;

        const animate = (time) => {
            const t = Math.min((time - startTime) / duration, 1);
            const ease = 1 - Math.pow(1 - t, 3);

            this.transform.x = startX + (targetX - startX) * ease;
            this.transform.y = startY + (targetY - startY) * ease;
            this.draw();

            if (t < 1) requestAnimationFrame(animate);
        };

        requestAnimationFrame(animate);
    }

    setupListeners() {
        this.dom.filterLabel.addEventListener("change", () => this.updateGraph());
        this.dom.filterGroup.addEventListener("change", () => this.updateGraph());
        this.dom.filterPerson.addEventListener("change", () => this.updateGraph());

        this.dom.btnResetZoom.addEventListener("click", () => this.resetZoom());

        this.dom.detailsClose.addEventListener("click", (e) => {
            e.stopPropagation();
            this.clearNodeSelection();
        });

        this.setupSearch();

        window.addEventListener("resize", () => {
            if (!this.canvas || !this.simulation) return;
            const container = this.dom.container;
            const width = container.clientWidth;
            const height = container.clientHeight;
            if (width === 0 || height === 0) return;
            const dpr = window.devicePixelRatio || 1;
            this.canvasW = width;
            this.canvasH = height;
            this.canvas.width = width * dpr;
            this.canvas.height = height * dpr;
            this.canvas.style.width = width + "px";
            this.canvas.style.height = height + "px";
            this.simulation.force("center", d3.forceCenter(width / 2, height / 2));
            this.simulation.alpha(0.1).restart();
        });
    }
}

document.addEventListener("DOMContentLoaded", () => {
    const app = new KPopNetworkGraph();
    app.initialize();
});
